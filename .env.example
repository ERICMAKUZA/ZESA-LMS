# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DEMO_MODE=True

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=zesa_ilmp
POSTGRES_USER=ilmp_user
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgres://ilmp_user:changeme@postgres:5432/zesa_ilmp

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@redis:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:changeme@redis:6379/0
CELERY_RESULT_BACKEND=redis://:changeme@redis:6379/1

# ── Moodle Database ───────────────────────────────────────────────────────────
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle_user
MOODLE_DB_PASSWORD=changeme
MOODLE_DB_ROOT_PASSWORD=changeme_root

# ── Moodle Application ────────────────────────────────────────────────────────
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASS=changeme
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_BASE_URL=http://localhost/lms
MOODLE_WSTOKEN=your-moodle-web-services-token

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=user@example.com
EMAIL_HOST_PASSWORD=changeme
DEFAULT_FROM_EMAIL=noreply@example.com

# ── Paynow ────────────────────────────────────────────────────────────────────
PAYNOW_INTEGRATION_ID=your-integration-id
PAYNOW_INTEGRATION_KEY=your-integration-key
PAYNOW_RETURN_URL=http://localhost/payment/return/
PAYNOW_RESULT_URL=http://localhost/payment/result/

# ── SAP ───────────────────────────────────────────────────────────────────────
SAP_BASE_URL=https://sap.example.com/api
SAP_USERNAME=sap_user
SAP_PASSWORD=changeme

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Next.js public runtime config ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_MOODLE_URL=http://localhost/lms
